# For local development with docker compose
POSTGRES_DB=my_space
POSTGRES_USER=my_space
POSTGRES_PASSWORD=replace-with-a-long-local-password
DATABASE_URL=postgresql://my_space:replace-with-a-long-local-password@127.0.0.1:5432/my_space
JWT_SECRET=generate-at-least-32-random-characters
PORT=3001
HOST=127.0.0.1
MEDIA_DIR=./uploads
COOKIE_PATH=/blog
COOKIE_SECURE=false
PUBLIC_API_PREFIX=/blog/api
SESSION_TTL_DAYS=14
UPLOAD_LIMIT_BYTES=3000000
